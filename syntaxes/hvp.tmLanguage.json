{
  "//": "GENERATED by hvp-language-server/tools/gen-grammars.ts from src/core/keywords.ts — do not edit by hand.",
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HVP",
  "scopeName": "source.hvp",
  "fileTypes": [
    "hvp"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declaration-name"
    },
    {
      "include": "#keywords-block"
    },
    {
      "include": "#keywords-declaration"
    },
    {
      "include": "#keywords-type"
    },
    {
      "include": "#builtin-metrics"
    },
    {
      "include": "#keywords-filter"
    },
    {
      "include": "#keywords-field"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.hvp",
          "match": "//.*$"
        },
        {
          "name": "comment.block.hvp",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.hvp",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.hvp",
          "match": "\\\\."
        },
        {
          "name": "variable.other.hvp",
          "match": "\\$\\{[A-Za-z_]\\w*\\}"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.percent.hvp",
          "match": "\\b\\d+(\\.\\d+)?%"
        },
        {
          "name": "constant.numeric.float.hvp",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.hvp",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords-block": {
      "name": "keyword.control.hvp",
      "match": "\\b(endoverride|endfeature|endmeasure|endmetric|endfilter|elseuntil|override|enduntil|feature|measure|endplan|subplan|metric|filter|until|plan|else)\\b"
    },
    "keywords-declaration": {
      "name": "storage.type.hvp",
      "match": "\\b(annotation|attribute)\\b"
    },
    "keywords-type": {
      "name": "support.type.hvp",
      "match": "\\b(aggregate|integer|percent|string|ratio|real|enum|set)\\b"
    },
    "keywords-field": {
      "name": "variable.other.property.hvp",
      "match": "\\b(test\\.expected|description|aggregator|at_least|weight|source|owner|phase|apply|goal)\\b"
    },
    "builtin-metrics": {
      "name": "entity.name.type.hvp",
      "match": "\\b(test\\.percent\\.unknown|test\\.percent\\.assert|test\\.percent\\.pass|test\\.percent\\.fail|test\\.percent\\.warn|Group\\.grp_count|Group\\.cvp_count|Group\\.bin_count|test\\.completion|AssertResult|test\\.unknown|test\\.assert|test\\.pass|test\\.fail|test\\.warn|SnpsAvg|Toggle|Branch|Assert|Group|Line|Cond|test|FSM)\\b"
    },
    "keywords-filter": {
      "name": "keyword.control.hvp",
      "match": "\\b(remove|where|keep)\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.hvp",
          "match": "==|!=|>=|<=|&&|\\|\\||!|>|<"
        },
        {
          "name": "keyword.operator.arithmetic.hvp",
          "match": "\\+|-|\\*|/"
        },
        {
          "name": "keyword.operator.assignment.hvp",
          "match": "="
        }
      ]
    },
    "declaration-name": {
      "match": "^\\s*(feature|plan|subplan|override|filter)\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "keyword.control.hvp"
        },
        "2": {
          "name": "entity.name.function.hvp"
        }
      }
    }
  }
}

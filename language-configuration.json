{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?!.*\\bend(?:plan|feature|metric|measure|override|filter|until)\\b)(?:plan|feature|metric|measure|override|filter|until)\\b|else(?:until)?\\b)",
    "decreaseIndentPattern": "^\\s*(?:end(?:plan|feature|metric|measure|override|filter|until)|else(?:until)?)\\b"
  }
}
